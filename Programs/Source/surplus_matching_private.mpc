from Compiler.types import sint
from Compiler.library import print_ln_to

T = 10
N = 6
NUM_SKILLS = 6

# ----------------------------
# Helpers sobre valores secretos
# ----------------------------

def smax(a, b):
    c = a > b
    return b + c * (a - b)

def smin(a, b):
    c = a > b
    return a - c * (a - b)

def positive_part(x):
    return x * (x > 0)

def pair_metrics(def_i, sur_i, def_j, sur_j):
    benefit = sint(0)
    coverage = sint(0)
    worst = sint(0)

    for k in range(NUM_SKILLS):
        help_i_from_j = smin(def_i[k], sur_j[k])
        help_j_from_i = smin(def_j[k], sur_i[k])

        benefit += help_i_from_j + help_j_from_i
        coverage += (help_i_from_j > 0)
        coverage += (help_j_from_i > 0)

        rem_i = def_i[k] - help_i_from_j
        rem_j = def_j[k] - help_j_from_i

        worst = smax(worst, rem_i)
        worst = smax(worst, rem_j)

    useful = benefit > 0
    return benefit, coverage, worst, useful

def better(matched_a, benefit_a, coverage_a, worst_a,
           matched_b, benefit_b, coverage_b, worst_b):
    g1 = matched_a > matched_b
    e1 = matched_a == matched_b
    g2 = benefit_a > benefit_b
    e2 = benefit_a == benefit_b
    g3 = coverage_a > coverage_b
    e3 = coverage_a == coverage_b
    # MENOR worst es mejor
    g4 = worst_a < worst_b

    return (
        g1
        + e1 * g2
        + e1 * e2 * g3
        + e1 * e2 * e3 * g4
    )

def partner_if_useful(useful, partner_id):
    # -1 = no good match
    return -1 + useful * (partner_id + 1)

# ----------------------------
# 1. Inputs privados
# Cada país mete 4 skills
# ----------------------------

X = []
for i in range(N):
    row = []
    for k in range(NUM_SKILLS):
        row.append(sint.get_input_from(i))
    X.append(row)

# ----------------------------
# 2. Déficit y surplus secretos
# ----------------------------

D = []
S = []

for i in range(N):
    drow = []
    srow = []
    for k in range(NUM_SKILLS):
        drow.append(positive_part(T - X[i][k]))
        srow.append(positive_part(X[i][k] - T))
    D.append(drow)
    S.append(srow)

# ----------------------------
# 3. Métricas de todas las parejas posibles
# ----------------------------

pair_info = {}

for i in range(N):
    for j in range(i + 1, N):
        pair_info[(i, j)] = pair_metrics(D[i], S[i], D[j], S[j])

# ----------------------------
# 4. Matchings globales para 6 países
# Se forman 3 parejas
# ----------------------------

def generate_matchings(remaining):
    if len(remaining) == 0:
        return [[]]

    first = remaining[0]
    results = []

    for j in range(1, len(remaining)):
        second = remaining[j]

        rest = remaining[1:j] + remaining[j+1:]

        for matching in generate_matchings(rest):
            results.append([(first, second)] + matching)

    return results


matchings = generate_matchings(list(range(N)))

candidate_data = []

for matching in matchings:

    matched = sint(0)
    benefit = sint(0)
    coverage = sint(0)
    worst = sint(0)

    pair_details = []

    for a, b in matching:

        pair_benefit, pair_coverage, pair_worst, useful = pair_info[(a, b)]

        matched += 2 * useful
        benefit += pair_benefit
        coverage += pair_coverage
        worst = smax(worst, pair_worst)

        pair_details.append((a, b, useful))

    candidate_data.append(
        (matched, benefit, coverage, worst, pair_details)
    )
# ----------------------------
# 5. Selección del mejor matching
# ----------------------------

winner = sint(0)

best_matched = candidate_data[0][0]
best_benefit = candidate_data[0][1]
best_coverage = candidate_data[0][2]
best_worst = candidate_data[0][3]

for idx in range(1, len(candidate_data)):
    matched = candidate_data[idx][0]
    benefit = candidate_data[idx][1]
    coverage = candidate_data[idx][2]
    worst = candidate_data[idx][3]

    choose = better(
        matched, benefit, coverage, worst,
        best_matched, best_benefit, best_coverage, best_worst
    )

    winner = choose * idx + (1 - choose) * winner
    best_matched = choose * matched + (1 - choose) * best_matched
    best_benefit = choose * benefit + (1 - choose) * best_benefit
    best_coverage = choose * coverage + (1 - choose) * best_coverage
    best_worst = choose * worst + (1 - choose) * best_worst

# ----------------------------
# 6. Partner secreto de cada país
# ----------------------------

partner_options = []

for candidate in candidate_data:

    pair_details = candidate[4]

    partners = [sint(-1) for _ in range(N)]

    for a, b, useful in pair_details:

        partners[a] = partner_if_useful(useful, b)
        partners[b] = partner_if_useful(useful, a)

    partner_options.append(partners)


partner_final = []

for i in range(N):

    val = sint(0)

    for idx in range(len(partner_options)):

        is_this = (winner == idx)

        val += is_this * partner_options[idx][i]

    partner_final.append(val)
# ----------------------------
# 7. SOLO salida privada
# ----------------------------

for i in range(N):
    out = partner_final[i].reveal_to(i)
    print_ln_to(i, 'YOUR PARTNER CODE = %s', out)
